{
  "manifest_version": 3,
  "name": "TrueCost",
  "version": "0.1.0",
  "description": "Your budget, watching your back while you shop.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://truecost-production.up.railway.app/*",
    "http://api.amsterhamster.com/*",
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "https://www.myntra.in/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*"],
      "js": ["content/shopping-detector.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}